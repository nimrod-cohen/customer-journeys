{
  "name": "@cdp/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./email-design": {
      "types": "./dist/email-design/index.d.ts",
      "default": "./dist/email-design/index.js"
    },
    "./js-sandbox": {
      "types": "./dist/js-sandbox.d.ts",
      "default": "./dist/js-sandbox.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  }
}
